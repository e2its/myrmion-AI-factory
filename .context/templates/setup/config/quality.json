{
  "$schema": "quality_v1",
  "complexity": {
    "enabled": true,
    "mcp_server": "{{COMPLEXITY_MCP_SERVER}}",
    "mcp_tool_name": "{{COMPLEXITY_MCP_TOOL_NAME}}",
    "thresholds": {
      "soft": 10,
      "hard": 15
    },
    "bvl_gate": true,
    "pr_blocker": false,
    "source_extensions": [
      ".py",
      ".js",
      ".ts",
      ".tsx",
      ".jsx",
      ".go",
      ".java",
      ".rb",
      ".php",
      ".c",
      ".cpp",
      ".cs",
      ".swift",
      ".kt",
      ".rs"
    ]
  },
  "code_review": {
    "enabled": true,
    "pr_blocker": true,
    "gate_blocking_agents": [
      "code-reviewer",
      "silent-failure-hunter",
      "pr-test-analyzer"
    ],
    "conditional_agents": [
      "type-design-analyzer"
    ],
    "advisory_agents": [
      "comment-analyzer",
      "code-simplifier"
    ]
  },
  "security_scan": {
    "enabled": true,
    "scanner": "{{SECURITY_SCANNER}}",
    "secrets_command": "{{SECURITY_SCANNER_COMMAND}}",
    "report_format": "exit-code",
    "fail_on": "any",
    "install_hint": "{{SECURITY_SCANNER_INSTALL_HINT}}"
  },
  "budgets": {
    "_doc": "Injection budgets in BYTES per point (EVOL-043). One reader measures the REAL producer at its worst case: python3 scripts/gate.py budget. Raising a key needs its record in the changelog.",
    "session_start": 2000,
    "prompt_submit": 16000,
    "pre_edit": 6000,
    "snapshot": 16000,
    "law_sentence_max_chars": 240,
    "dc_invariant_max_chars": 160
  },
  "retired_terms": [
    {
      "term": "Governance Index (Auto-Generated)",
      "record": "ADR-EVOL-043",
      "exempt": []
    },
    {
      "term": "applicability_context.json",
      "record": "ADR-EVOL-043",
      "exempt": []
    },
    {
      "term": "docs/rules/",
      "record": "ADR-EVOL-043",
      "exempt": []
    }
  ]
}
