{
  "$schema": "measure_config_v1",
  "retention_days": {{MEASURE_RETENTION_DAYS}},
  "report_interval_days": {{MEASURE_REPORT_INTERVAL_DAYS}},
  "idle_cap_s": 300,
  "turn_bucket": 40,
  "output_unrecorded_chars_per_token": 20,
  "gates": {
    "verification": ["validate-governance\\.sh", "check-[a-z-]+\\.sh", "test-[a-z-]+\\.sh", "\\bpytest\\b", "\\bnpm (run )?test\\b", "\\bnpx (vitest|jest|playwright)\\b", "\\bgo test\\b", "\\bmvn (test|verify)\\b", "\\bdotnet test\\b", "\\bcargo test\\b", "\\btsc\\b", "\\bruff\\b", "\\beslint\\b"],
    "push": ["\\bgit\\s+push\\b", "preflight\\.sh"],
    "deploy": ["\\bpulumi (up|preview)\\b", "\\bterraform (apply|plan)\\b", "\\bcdk deploy\\b", "\\bdocker (build|push)\\b", "\\bhelm (upgrade|install)\\b", "\\bkubectl apply\\b", "\\bgh workflow run\\b"],
    "e2e": ["\\bplaywright test\\b", "\\bcypress run\\b"]
  },
  "review_patterns": ["preflight\\.sh", "code_review", "pr-review"],
  "review_agent_patterns": ["critic", "review"],
  "governance_paths": ["CLAUDE.md", "docs/constitution.md", "docs/setup.md", ".context/governance_snapshot.md", ".claude/rules/", ".claude/instructions/", ".claude/skills/", ".claude/commands/", ".claude/agents/", "docs/project_log/adr/"],
  "corpus_files": ["CLAUDE.md", "docs/constitution.md", ".claude/rules/defect-prevention.md"],
  "rework_commit_types": ["fix", "revert"],
  "prices": {"as_of": "2026-10-20", "source": "Anthropic list prices, $ per million tokens", "per_family": {"opus": {"input": 4.0, "cache_write_5m": 5.0, "cache_write_1h": 8.0, "cache_read": 0.20, "output": 20.0}, "sonnet": {"input": 2.0, "cache_write_5m": 2.5, "cache_write_1h": 4.0, "cache_read": 0.10, "output": 10.0}, "haiku": {"input": 1.0, "cache_write_5m": 1.25, "cache_write_1h": 2.0, "cache_read": 0.05, "output": 5.0}}}
}
