         "scoped": "PYTHONPATH=src${PYTHONPATH:+:$PYTHONPATH} python -m pytest {paths} -x --tb=short -q"
        },
        "coverage": {
         "command": "python -m pytest --cov --cov-report=term-missing --cov-report=lcov:coverage/lcov.info -q",
         "report": "coverage/lcov.info"
        },
        "lint": {
         "command": "ruff check ."
        },
        "sca": {
         "command": "if command -v pip-audit >/dev/null 2>&1; then pip-audit --strict --desc; elif command -v safety >/dev/null 2>&1; then safety check; else pip-audit --strict --desc; fi"
        },
        "typecheck": {
         "command": "if [ -f mypy.ini ] || { [ -f pyproject.toml ] && grep -q '^\\[tool\\.mypy' pyproject.toml; }; then mypy .; fi"
        }
       },
