        "tests/**"
       ]
      },
      "Node.js": {
       "verification.gates": {
        "tests": {
         "command": "if [ -f vitest.config.ts ] || [ -f vitest.config.js ]; then npx vitest run --coverage --reporter=text --coverage.reporter=text --coverage.reporter=lcov; else npx jest --coverage --coverageReporters=text-summary --coverageReporters=lcov --no-cache; fi",
         "scoped": "if [ -f vitest.config.ts ] || [ -f vitest.config.js ]; then npx vitest run {paths}; elif [ -f .mocharc.yml ] || [ -f .mocharc.json ]; then npx mocha {paths}; else npx jest {paths} --no-coverage --verbose; fi",
         "red_link": [
          "node_modules"
         ]
        },
        "coverage": {
         "command": "if [ -f vitest.config.ts ] || [ -f vitest.config.js ]; then npx vitest run --coverage --reporter=text --coverage.reporter=text --coverage.reporter=lcov; else npx jest --coverage --coverageReporters=text-summary --coverageReporters=lcov --no-cache; fi",
         "report": "coverage/lcov.info"
        },
        "lint": {
         "command": "npx eslint . --max-warnings 0"
        },
        "sca": {
         "command": "npm audit --omit=dev --audit-level=$(echo {sca_threshold} | sed s/medium/moderate/)"
        },
        "typecheck": {
         "command": "test ! -f tsconfig.json || npx tsc --noEmit"
        },
        "build": {
         "command": "test ! -f package.json || npm run build --if-present"
        }
       },
       "traceability.test_roots": [
        "tests/**",
        "e2e/**",
        "src/**/*.test.*",
        "src/**/*.spec.*"
       ]
      },
      "Java": {
       "verification.gates": {
        "tests": {
         "command": "mvn verify -Djacoco.skip=false -q",
         "scoped": "mvn test -q -Dtest={paths}",
         "red": false
        },
        "coverage": {
         "command": "mvn verify -Djacoco.skip=false -q"
        },
        "build": {
         "command": "mvn compile -q"
        },
        "sca": {
         "command": "case {sca_threshold} in critical) c=9;; high) c=7;; medium) c=4;; *) c=0;; esac; mvn -q org.owasp:dependency-check-maven:check -DfailBuildOnCVSS=$c"
        }
       },
       "traceability.test_roots": [
        "src/test/**"
       ]
      },
      "Go": {
       "verification.gates": {
        "tests": {
         "command": "go test ./... -coverprofile=coverage.out && go tool cover -func=coverage.out",
         "scoped": "go test {paths} -v",
         "red": false
        },
        "coverage": {
         "command": "go test ./... -coverprofile=coverage.out && go tool cover -func=coverage.out"
        },
        "lint": {
         "command": "golangci-lint run ./..."
        },
        "build": {
         "command": "go build ./..."
        },
        "sca": {
         "command": "govulncheck ./..."
        }
       },
       "traceability.test_roots": [
        "**/*_test.go"
       ]
      },
      ".NET": {
       "verification.gates": {
        "tests": {
         "command": "dotnet test --collect:'XPlat Code Coverage' --results-directory ./coverage",
         "scoped": "dotnet test --filter {paths} --verbosity minimal",
         "red": false
        },
        "coverage": {
         "command": "dotnet test --collect:'XPlat Code Coverage' --results-directory ./coverage"
        },
        "lint": {
         "command": "dotnet format --verify-no-changes"
        },
        "build": {
         "command": "dotnet build --no-restore"
        },
        "sca": {
         "command": "out=$(dotnet list package --vulnerable --include-transitive 2>&1) || { echo \"$out\"; exit 1; }; echo \"$out\"; ! printf '%s' \"$out\" | grep -qE 'has the following vulnerable packages|NU1900|Unable to load the service index'"
        }
