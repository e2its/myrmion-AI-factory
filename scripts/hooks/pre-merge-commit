#!/usr/bin/env bash
# Generated by Agent: IMPLEMENT | Feature: EVOL-065
# ============================================================================
# pre-merge-commit hook — a merge commit is a commit: git runs this hook (not pre-commit) for a merge that
# completes without conflict, so it runs the pre-commit hook (branch guard + secrets) beside it.
# Installed hooks are copies (scripts/install-hooks.sh): the sibling is resolved from this file's own directory.
# ============================================================================
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)
for pc in "$here/pre-commit" "$(git rev-parse --git-path hooks/pre-commit 2>/dev/null)" scripts/hooks/pre-commit; do
  if [ -n "$pc" ] && [ -f "$pc" ]; then
    exec bash "$pc" "$@"
  fi
done
echo "❌ pre-merge-commit: the pre-commit hook is not installed — the merge cannot be checked. Resolution: bash scripts/install-hooks.sh, then retry." >&2
exit 1
