#!/usr/bin/env bash
# Generated by Agent: IMPLEMENT | Feature: EVOL-005
# ============================================================================
# pre-commit hook — Runs lightweight checks before each commit
# ============================================================================
# Checks:
#   1. Protected branch guard (prevent direct commits to main)
#   2. Secret leak detection (if gitleaks available)
#   (governance validation runs at push as a member of the gate profile — EVOL-046)
# ============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# ── 1. Protected branch guard — ONE definition (EVOL-046): the reader classifies the name (main, master,
#      develop, release/*, bare hotfix, a train with declared sub-increments). Reader absent = fail-closed.
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "")
if [ -n "$CURRENT_BRANCH" ]; then
  if [ ! -f scripts/gate.py ]; then
    echo -e "${RED}❌ The governance reader (scripts/gate.py) is not delivered — '$CURRENT_BRANCH' cannot be classified.${NC}"
    echo "   Resolution: bash scripts/factory-sync.sh, then retry the commit."
    exit 1
  fi
  BC_OUT=$(python3 scripts/gate.py branch-class --protected 2>&1) && BC_RC=0 || BC_RC=$?
  if [ "$BC_RC" -eq 1 ]; then
    echo -e "${RED}❌ Direct commits to '$CURRENT_BRANCH' are blocked ($BC_OUT).${NC}"
    echo "   Create a working branch: git checkout -b feature/YOUR-ID-description  (a train takes sub-increment PRs only)"
    exit 1
  elif [ "$BC_RC" -ne 0 ]; then
    echo -e "${RED}❌ The governance reader could not classify '$CURRENT_BRANCH' (exit $BC_RC): $BC_OUT${NC}"
    exit 1
  fi
fi

# ── 2. Secret leak detection (optional — skips if gitleaks not installed) ──
if command -v gitleaks &>/dev/null; then
  if ! gitleaks protect --staged --no-banner 2>/dev/null; then
    echo -e "${RED}❌ Potential secrets detected in staged files.${NC}"
    echo "   Review findings above and remove secrets before committing."
    exit 1
  fi
else
  # Silent skip — gitleaks is recommended but not required
  :
fi

# (governance validation moved to the push — it is a member of the gate profile, EVOL-046)
